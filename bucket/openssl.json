{
    "version": "3.5.8",
    "description": "TLS/SSL toolkit. Pinned to the 3.5 LTS series - only 3.5.x security/patch releases are ever picked up.",
    "homepage": "https://slproweb.com/products/Win32OpenSSL.html",
    "license": "Apache-2.0",
    "notes": "Pinned to the OpenSSL 3.5 LTS series (supported until 2030-04-08): updates follow 3.5.x only, never 3.6.x or 4.x.",
    "architecture": {
        "64bit": {
            "url": "https://slproweb.com/download/Win64OpenSSL-3_5_8.exe",
            "hash": "0125ee1ea63bf288630161e75b60554b83e00c739441233f8f9703dc4a8f32f9"
        },
        "32bit": {
            "url": "https://slproweb.com/download/Win32OpenSSL-3_5_8.exe",
            "hash": "d55ddf392cb0ec31b3210fc9c6a9702a3c8cd95440ada96167226b6fc106f836"
        },
        "arm64": {
            "url": "https://slproweb.com/download/Win64ARMOpenSSL-3_5_8.exe",
            "hash": "2a51e2eca9834a78ea5123df6212f54ff84ee4658ed5af3d112900c5e45cd784"
        }
    },
    "innosetup": true,
    "pre_install": [
        "$arch = switch ($architecture) {",
        "    '64bit' { 'x64'; break }",
        "    '32bit' { 'x86'; break }",
        "    'arm64' { $architecture; break }",
        "}",
        "$null = Get-ChildItem \"$dir/lib/VC/$arch/MT\" | ForEach-Object { New-Item -Force -ItemType HardLink -Target $_.FullName -Path \"$dir/lib/$($_.Name)\" }"
    ],
    "env_add_path": "bin",
    "env_set": {
        "OPENSSL_ROOT_DIR": "$dir",
        "OPENSSL_LIB_DIR": "$dir\\lib",
        "OPENSSL_INCLUDE_DIR": "$dir\\include",
        "OPENSSL_MODULES": "$dir\\bin",
        "OPENSSL_CONF": "$dir\\bin\\cnf\\openssl.cnf"
    },
    "checkver": {
        "script": [
            "$series = '3.5.'",
            "$feed = 'https://raw.githubusercontent.com/slproweb/opensslhashes/master/win32_openssl_hashes.json'",
            "$json = Invoke-RestMethod -Uri $feed",
            "$json.files.PSObject.Properties |",
            "    Where-Object { $_.Name -like 'Win64OpenSSL-*.exe' -and $_.Value.basever -like \"$series*\" } |",
            "    ForEach-Object { [version]$_.Value.basever } |",
            "    Sort-Object -Descending |",
            "    Select-Object -First 1 |",
            "    ForEach-Object { $_.ToString() }"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://slproweb.com/download/Win64OpenSSL-$underscoreVersion.exe"
            },
            "32bit": {
                "url": "https://slproweb.com/download/Win32OpenSSL-$underscoreVersion.exe"
            },
            "arm64": {
                "url": "https://slproweb.com/download/Win64ARMOpenSSL-$underscoreVersion.exe"
            }
        },
        "hash": {
            "url": "https://raw.githubusercontent.com/slproweb/opensslhashes/master/win32_openssl_hashes.json",
            "jsonpath": "$.files.['$basename'].sha256"
        }
    }
}
